{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "bootstrap@5.3.3",
      "destination": "wwwroot/lib/bootstrap",
      "files": [
        "css/bootstrap.min.css",
        "js/bootstrap.bundle.min.js"
      ]
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery",
      "files": [
        "jquery.min.js"
      ]
    },
    {
      "library": "font-awesome@6.5.0",
      "destination": "wwwroot/lib/font-awesome",
      "files": [
        "css/all.min.css",
        "webfonts/*"
      ]
    },
    {
      "provider": "unpkg",
      "library": "@fontsource/vazirmatn@5.0.2",
      "destination": "wwwroot/lib/vazirmatn",
      "files": [
        "400.css",
        "500.css",
        "600.css",
        "700.css",
        "800.css",
        "files/*-400-normal.woff2",
        "files/*-500-normal.woff2",
        "files/*-600-normal.woff2",
        "files/*-700-normal.woff2",
        "files/*-800-normal.woff2"
      ]
    },
    {
      "provider": "unpkg",
      "library": "@fontsource/jetbrains-mono@5.0.2",
      "destination": "wwwroot/lib/jetbrains-mono",
      "files": [
        "400.css",
        "500.css",
        "600.css",
        "files/*-400-normal.woff2",
        "files/*-500-normal.woff2",
        "files/*-600-normal.woff2"
      ]
    }
  ]
}