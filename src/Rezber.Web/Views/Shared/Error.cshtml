@{
    ViewData["Title"] = "Error";
}

<div class="container-xxl py-5 text-center">
    <i class="fas fa-exclamation-triangle" style="font-size:64px;color:var(--c-warning);opacity:0.5;"></i>
    <h1 class="mt-4">Something went wrong</h1>
    <p style="color:var(--c-gray-2);">Unfortunately, there was a problem processing your request.</p>
    <a asp-controller="PackageBrowser" asp-action="Index" class="btn btn-primary mt-3">
        <i class="fas fa-home"></i> Back to home
    </a>
</div>