@model List<UserDto>
@{
    ViewData["Title"] = "User management";
}

<div class="container-xxl pt-4 pb-5">
    <div class="mb-4">
        <div class="dashboard-title">
            <i class="fas fa-crown" style="color:var(--c-warning);margin-left:6px;"></i>
            Admin panel
        </div>
    </div>

    <partial name="~/Views/Admin/_AdminTabs.cshtml" model='@("Users")' />

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    <div class="dash-section">
        <div class="dash-section-title mb-3"><i class="fas fa-user-plus"></i> Create developer account</div>
        <form asp-action="CreateUser" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label for="newDisplayName" class="form-label">Display name</label>
                <input id="newDisplayName" name="displayName" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label for="newEmail" class="form-label">Email</label>
                <input id="newEmail" name="email" type="email" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label for="newJobTitle" class="form-label">Job title</label>
                <input id="newJobTitle" name="jobTitle" class="form-control" value="Developer" required />
            </div>
            <div class="col-md-2">
                <label for="newPassword" class="form-label">Temporary password</label>
                <input id="newPassword" name="password" type="password" class="form-control" autocomplete="new-password" required />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit"><i class="fas fa-plus me-1"></i> Create</button>
            </div>
        </form>
    </div>

    <div class="dash-section">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
            <div class="dash-section-title"><i class="fas fa-users"></i> User management</div>
            <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2">
                <select name="status" class="form-select">
                    <option value="">All statuses</option>
                    <option value="active" selected="@(ViewBag.StatusFilter as string == "active" ? "selected" : null)">Active</option>
                    <option value="inactive" selected="@(ViewBag.StatusFilter as string == "inactive" ? "selected" : null)">Inactive</option>
                </select>
                <select name="role" class="form-select">
                    <option value="">All roles</option>
                    <option value="Developer" selected="@(ViewBag.RoleFilter as string == "Developer" ? "selected" : null)">Developer</option>
                    <option value="Admin" selected="@(ViewBag.RoleFilter as string == "Admin" ? "selected" : null)">Admin</option>
                </select>
                <button class="btn btn-secondary" type="submit">Filter</button>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>User</th><th>Role</th><th>Packages</th><th>Storage</th><th>Last activity</th><th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--c-purple),var(--c-info));display:grid;place-items:center;font-size:11px;font-weight:700;color:#fff;">
                                        @u.Initials
                                    </div>
                                    <div>
                                        <div style="color:var(--c-white);font-weight:500;">@u.DisplayName</div>
                                        <div style="font-size:11px;color:var(--c-gray-3);direction:ltr;">@u.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge-custom @(u.IsAdmin ? "warning" : "info")">
                                    @u.PrimaryRole
                                </span>
                            </td>
                            <td class="cell-mono">@u.PackageCount</td>
                            <td class="cell-mono">@u.StorageMb MB</td>
                            <td>@u.LastActive.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge-custom @(u.IsActive ? "success" : "neutral")">
                                    <span class="dot-status"></span> @(u.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-nowrap">
                                <button type="button" class="tbl-icon-btn me-1" title="Edit user"
                                        data-bs-toggle="modal" data-bs-target="#editUserModal"
                                        data-user-id="@u.Id" data-user-name="@u.DisplayName"
                                        data-user-job-title="@u.JobTitle" data-user-active="@u.IsActive.ToString().ToLowerInvariant()">
                                    <i class="fas fa-pen"></i>
                                </button>
                                @if (!u.IsAdmin)
                                {
                                    <button type="button" class="tbl-icon-btn danger" title="Delete user"
                                            data-bs-toggle="modal" data-bs-target="#deleteUserModal"
                                            data-user-id="@u.Id" data-user-name="@u.DisplayName">
                                        <i class="fas fa-user-slash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:480px;">
        <div class="modal-content">
            <form asp-action="UpdateUser" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editUserId" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit user</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editUserName" class="form-label">Display name</label>
                        <input id="editUserName" name="displayName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="editUserJobTitle" class="form-label">Job title</label>
                        <input id="editUserJobTitle" name="jobTitle" class="form-control" required />
                    </div>
                    <label class="form-check-label d-flex align-items-center gap-2">
                        <input id="editUserActive" name="isActive" type="checkbox" value="true" class="form-check-input mt-0" />
                        Account is active
                    </label>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content">
            <form asp-action="DeleteUser" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteUserId" />
                <div class="modal-body text-center py-4">
                    <div class="confirm-icon-lg"><i class="fas fa-user-slash"></i></div>
                    <h5 class="modal-title mb-2">Delete user</h5>
                    <p style="color:var(--c-gray-2);font-size:13.5px;">
                        Are you sure?
                        <br>
                        <span class="target-name" id="deleteUserName">-</span>
                    </p>
                    <div class="d-flex gap-2 mt-4">
                        <button type="button" class="btn btn-secondary flex-fill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger flex-fill">Delete</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteUserModal')?.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('deleteUserId').value = btn.getAttribute('data-user-id');
            document.getElementById('deleteUserName').textContent = btn.getAttribute('data-user-name');
        });
            document.getElementById('editUserModal')?.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                document.getElementById('editUserId').value = btn.getAttribute('data-user-id');
                document.getElementById('editUserName').value = btn.getAttribute('data-user-name');
                document.getElementById('editUserJobTitle').value = btn.getAttribute('data-user-job-title');
                document.getElementById('editUserActive').checked = btn.getAttribute('data-user-active') === 'true';
            });
    </script>
}
