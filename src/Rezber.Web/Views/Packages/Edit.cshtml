@model PackageEditDto
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="container-xxl pt-4 pb-5">
    <div class="mb-4">
        <a class="breadcrumb-custom" asp-action="Details" asp-route-id="@Model.Id"><i class="fas fa-chevron-right"></i> Back to package</a>
        <h1 class="dashboard-title mt-3">Edit package</h1>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="dash-section">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden">
        <input asp-for="Version" type="hidden">
        <input asp-for="Language" type="hidden">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label">Package name</label>
                <input asp-for="Name" class="form-control">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Version</label>
                <input class="form-control" value="@Model.Version" disabled>
            </div>
            <div class="col-md-6">
                <label asp-for="Language" class="form-label">Language</label>
                <input class="form-control" value="@Model.Language" disabled>
            </div>
            <div class="col-md-6">
                <label asp-for="Target" class="form-label">Target framework or platform</label>
                <input asp-for="Target" class="form-control">
                <span asp-validation-for="Target" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Tags" class="form-label">Tags</label>
                <input asp-for="Tags" class="form-control">
            </div>
            <div class="col-md-6">
                <label asp-for="License" class="form-label">License</label>
                <input asp-for="License" class="form-control">
            </div>
            <div class="col-md-6">
                <label asp-for="RepositoryUrl" class="form-label">Repository URL</label>
                <input asp-for="RepositoryUrl" class="form-control" type="url">
                <span asp-validation-for="RepositoryUrl" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ReadmeUrl" class="form-label">README URL (optional)</label>
                <input asp-for="ReadmeUrl" class="form-control" type="url">
                <span asp-validation-for="ReadmeUrl" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Readme" class="form-label">README content</label>
                <textarea asp-for="Readme" class="form-control" rows="8"></textarea>
            </div>
            <div class="col-12">
                <label asp-for="Dependencies" class="form-label">Dependencies (one per line: name | version | type)</label>
                <textarea asp-for="Dependencies" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-12">
                <label for="imageFile" class="form-label">Package image (optional, up to 5 MB)</label>
                <input id="imageFile" name="imageFile" type="file" class="form-control" accept="image/*">
            </div>
            @if (Model.HasImage)
            {
                <div class="col-12">
                    <label class="toggle-wrap">
                        <input asp-for="RemoveImage">
                        <span class="toggle-track"></span>
                        <span>Remove current image</span>
                    </label>
                </div>
            }
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
