    "version": "0.2.0",
    "configurations": [
        {
            "name": "console",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Rezber.Cli/bin/Debug/net10.0/rezber.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "Rezber.Web",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/Rezber.Web/Rezber.Web.csproj"
        }
    ]
